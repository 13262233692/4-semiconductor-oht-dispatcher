{
  "name": "oht-dispatcher",
  "version": "1.0.0",
  "description": "300mm Semiconductor Fab OHT Traffic Control Center",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run start:dev",
    "dev:client": "npm --workspace client run dev",
